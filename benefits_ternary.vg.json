
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Why do people take out super? And how much?",
    "subtitle": [
      "Composition of benefit payments across retirement, age 65, preservation age and other categories",
      "Source: Australian Prudential Regulatory Authority (2026)"
    ]
  },
  "width": 600,
  "height": 600,
  "data": {
    "url": "data/clean/benefit_payments.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.retirement)",
      "as": "Retirement"
    },
    {
      "calculate": "toNumber(datum.age_65)",
      "as": "Age65"
    },
    {
      "calculate": "toNumber(datum.preservation)",
      "as": "Preservation"
    },
    {
      "calculate": "toNumber(datum.other)",
      "as": "Other"
    },
    {
      "calculate": "datum.Retirement + datum.Age65 + datum.Preservation",
      "as": "ReasonSum"
    },
    {
      "filter": "isValid(datum.ReasonSum) && datum.ReasonSum > 0"
    },
    {
      "calculate": "(datum.Age65 + 0.5 * datum.Preservation) / datum.ReasonSum",
      "as": "x"
    },
    {
      "calculate": "0.8660254 * datum.Preservation / datum.ReasonSum",
      "as": "y"
    },
    {
      "calculate": "indexof(['HESTA', 'Military Superannuation & Benefits Fund No 1', 'CSS Fund', 'Centric Super Fund'], datum.fund) >= 0 ? 'Highlighted funds' : 'Other funds'",
      "as": "Highlight"
    },
    {
      "calculate": "toNumber(datum.average_payments)",
      "as": "AveragePayments"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {"x": 0, "y": 0, "order": 1},
          {"x": 1, "y": 0, "order": 2},
          {"x": 0.5, "y": 0.8660254, "order": 3},
          {"x": 0, "y": 0, "order": 4}
        ]
      },
      "mark": {
        "type": "line",
        "color": "#19324D",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [-0.16, 1.16], "nice": false},
          "axis": null
        },
        "y": {

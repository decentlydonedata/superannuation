
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Superannuation’s Leading Funds: Who Holds Their Ground?",
    "subtitle": ["Rankings reveal a stable leader, shifting competition and changing positions among major super funds, 2015–2025.", 
                "Source: Australian Prudential Regulation Authority (2026)"]
  },
  "width": 700,
  "height": 300,
  "data": {
    "url": "data/clean/fund_rankings.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.Year >= 2015 && datum.Year <= 2025"
    },
    {
      "filter": "datum.Ranking_type === 'Assets'"
    }
  ],
  "params": [
    {
      "name": "fundSelect",
      "select": {
        "type": "point",
        "fields": ["Fund"],
        "on": "click",
        "clear": "dblclick"
      }
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 55
    },
    "strokeWidth": 4
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "sort": "ascending",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": {
        "reverse": true,
        "zero": false
      },
      "axis": {
        "tickMinStep": 1
      }
    },
    "detail": {
      "field": "Fund"
    },
    "color": {
  "condition": {
    "param": "fundSelect",
    "field": "Fund",
    "type": "nominal",
    "scale": {
"domain": [
  "AustralianSuper",
  "Australian Retirement Trust",
  "Aware Super",
  "Unisuper",
  "Public Sector Superannuation Scheme",
  "MLC Super Fund",
  "Colonial First State FirstChoice Superannuation Trust",
  "Retirement Wrap",
  "AMP Superannuation Savings Trust"
],
"range": [
  "#C49A45",
  "#247C83",
  "#54718C",
  "#42666A",
  "#7896AD",
  "#718B7A",
  "#85865B",
  "#9A8875",
  "#6B9A96"
]
  }
  },
  "value": "#D3D3D3"
},
    "opacity": {
      "condition": {
        "param": "fundSelect",
        "value": 1
      },
      "value": 0.2
    },
    "strokeWidth": {
      "condition": {
        "param": "fundSelect",
        "value": 4
      },
      "value": 1.5
    },
    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Rank",
        "type": "quantitative",
        "title": "Rank"
      },
      {
        "field": "Fund",
        "type": "nominal",
        "title": "Fund"
      },
      {
        "field": "ABN",
        "type": "nominal",
        "title": "ABN"
      },
      {
        "field": "Members",
        "type": "quantitative",
        "title": "Members",
        "format": ","
      },
      {
        "field": "Members",
        "type": "quantitative",
        "title": "Members",
        "format": ","
      }
    ]
  },
"background": "#F7F6F2",
"config": {
  "font": "Inter",
  "title": {
    "font": "Inter",
    "fontSize": 24,
    "fontWeight": 600,
    "color": "#19324D",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#526477",
    "subtitlePadding": 8
  },
  "text": {
    "font": "Inter",
    "fontSize": 16,
    "fill": "#526477"
  },
  "axis": {
    "labelFont": "Inter",
    "labelFontSize": 12,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 12,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "gridColor": "#E2E5E5",
    "gridWidth": 0.7,
    "domain": false,
    "tickColor": "#CBD3D6",
    "labelPadding": 6,
    "titlePadding": 10
  },
  "legend": {
    "labelFont": "Inter",
    "labelFontSize": 12,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 16,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "symbolSize": 100,
    "padding": 8,
    "labelLimit": 500
  },
  "view": {
    "stroke": null
  },
  "bar": {
    "cornerRadiusEnd": 3
  },
  "line": {
    "strokeWidth": 2.5,
    "point": true
  },
  "point": {
    "filled": true,
    "size": 55
  }
}
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/clean/account_distribution.csv"
  },
  "mark": {
    "type": "arc",
    "outerRadius": 150
  },
  "encoding": {
    "theta": {
      "field": "Proportion",
      "type": "quantitative",
      "stack": true
    },
    "radius": {
      "field": "Accounts",
      "type": "quantitative",
      "scale": {
        "range": [40, 150]
      }
    },
    "color": {
      "field": "Number of accounts",
      "type": "nominal"
    },
    "tooltip": [
      {"field": "Number of accounts"},
      {"field": "Proportion"}
    ]
  },
  "view": {
    "stroke": null
  },
  "config": {
    "font": "Inter",
    "title": {
        "font": "Inter",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#172B4D",
        "anchor": "start"
    },
    "axis": {
        "labelFont": "Inter",
        "titleFont": "Inter",
        "labelColor": "#344054",
        "titleColor": "#344054",
        "gridColor": "#E8EEF2",
        "domainColor": "#CBD5E1"
    },
    "legend": {
        "labelFont": "Inter",
        "titleFont": "Inter",
        "labelColor": "#344054",
        "titleColor": "#172B4D"
    },
    "view": {
        "stroke": null
    }
}
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/clean/account_distribution.csv"
  },
  "mark": {
    "type": "arc",
    "outerRadius": 150
  },
  "encoding": {
    "theta": {
      "field": "Proportion",
      "type": "quantitative",
      "stack": true
    },
    "radius": {
      "field": "Accounts",
      "type": "quantitative",
      "scale": {
        "range": [40, 150]
      }
    },
    "color": {
    "field": "Number of accounts",
    "type": "nominal",
    "scale": {
      "range": [
        "#247C83",
        "#718B7A",
        "#54718C",
        "#C49A45"
      ]
    },
      "legend": {
        "orient": "right",
        "title": null
      }
  },
    "tooltip": [
  {
    "field": "Number of accounts",
    "type": "nominal",
    "title": "Number of accounts"
  },
  {
    "field": "Proportion",
    "type": "quantitative",
    "title": "Share of people",
    "format": ".0%"
  }
  ]
  },
  "view": {
    "stroke": null
  },
  "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}


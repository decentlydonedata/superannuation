{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 450,
  "title": "SA2 Boundary Test",
  "data": {
    "url": "data/boundaries/abs-sa2-2021_2021-06-25.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.sa2_2021_name",
      "from": {
        "data": {
          "url": "data/clean/sa2_age.csv",
          "format": {
            "type": "csv"
          }
        },
        "key": "SA2_NAME",
        "fields": ["Average_Age"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.3
  },
  "projection": {
    "type": "mercator"
  },
  "encoding": {
    "color": {
      "field": "Average_Age",
      "type": "quantitative",
      "title": "Average age",
      "scale": {
        "scheme": "viridis"
      }
    },
    "tooltip": [
  {
    "field": "properties.sa2_2021_name",
    "type": "nominal",
    "title": "SA2"
  },
  {
    "field": "Average_Age",
    "type": "quantitative",
    "title": "Average Age",
    "format": ".1f"
  }
]
  }
}
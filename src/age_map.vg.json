

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Average age by Australian Statistical Area Level 2.",
  "width": 800,
  "height": 600,
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 700
  },
  "data": {
    "url": "data/clean/sa2_age_joined.geojson",
    "format": {
      "type": "json"
    }
  },
  "transform": [
    {
      "filter": "isValid(datum['Average Age'])"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.3
  },
  "encoding": {
    "color": {
      "field": "Average Age",
      "type": "quantitative",
      "title": "Average age (years)",
      "scale": {
        "scheme": "viridis"
      },
      "legend": {
        "format": ".1f",
        "orient": "bottom"
      }
    },
    "tooltip": [
      {
        "field": "SA2",
        "type": "nominal",
        "title": "SA2 code"
      },
      {
        "field": "SA2_NAME21",
        "type": "nominal",
        "title": "SA2 name"
      },
      {
        "field": "Average Age",
        "type": "quantitative",
        "title": "Average age",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}

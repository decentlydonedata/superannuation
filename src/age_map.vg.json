
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Distribution of Retirees Across Australia",
  "width": 700,
  "height": 600,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/clean/retiree_dots.csv",
    "format": {
      "type": "csv"
    }
  },
  "mark": {
    "type": "circle",
    "size": 12,
    "opacity": 0.7,
    "color": "#276FBF"
  },
  "encoding": {
    "longitude": {
      "field": "longitude",
      "type": "quantitative"
    },
    "latitude": {
      "field": "latitude",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "SA1",
        "type": "nominal",
        "title": "SA1"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Retiree percentage",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}

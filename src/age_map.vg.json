
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Age by Statistical Area Level 3",
    "subtitle": ["Average age across Australian SA3 regions",
                "Source: Australian Bureau of Statistics (2021)"]
  },
  "width": 650,
  "height": 600,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/clean/sa3_choropleth.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.3
  },
  "encoding": {
    "color": {
      "field": "properties.Average_Age",
      "type": "quantitative",
      "title": "Average age (years)",
      "scale": {
        "scheme": "viridis"
      }
    },
    "tooltip": [
      {
        "field": "properties.SA3_CODE21",
        "type": "nominal",
        "title": "SA3 code"
      },
      {
        "field": "properties.Average_Age",
        "type": "quantitative",
        "title": "Average age",
        "format": ".1f"
      }
    ]
  },
  "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}

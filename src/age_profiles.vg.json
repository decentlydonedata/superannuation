
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Estimated Median Superannuation Balance by Age",
    "subtitle": ["Comparison across 30 June 2022, 2024 and 2026",
                "Source: Australian Prudential Regulatory Authority (2026)"]
  },
  "width": 460,
  "height": 300,
  "data": {
    "url": "data/clean/age_profiles.csv",
    "format": {
      "type": "csv"
    }
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 65
    },
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "Age bracket",
      "type": "ordinal",
      "sort": [
        "<25",
        "25 to 29",
        "30 to 34",
        "35 to 39",
        "40 to 44",
        "45 to 49",
        "50 to 54",
        "55 to 59",
        "60 to 64",
        "65 to 69",
        "70 to 74",
        "75 to 84",
        "85+"
      ],
  "title": "Age bracket",
  "axis": {
    "labelAngle": -45,
    "labelLimit": 100,
    "labelFontSize": 11,
    "labelOverlap": false
  }
    },
    "y": {
      "field": "Estimated_median",
      "type": "quantitative",
      "title": "Estimated median balance (AUD)",
      "axis": {
        "format": "$,.0f"
      }
    },
    "color": {
      "field": "Date",
      "type": "nominal",
      "sort": [
        "2016",
        "2021",
        "2026"
      ],
      "scale": {
        "domain": [
          "2016",
          "2021",
          "2026"
        ],
        "range": [
          "#54718C",
          "#247C83",
          "#C49A45"
        ]
      },
      "legend": {
        "orient": "top",
        "title": null
      }
    },
    "detail": {
      "field": "Date"
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "nominal",
        "title": "Date"
      },
      {
        "field": "Age bracket",
        "type": "ordinal",
        "title": "Age bracket"
      },
      {
        "field": "Estimated_median",
        "type": "quantitative",
        "title": "Estimated median",
        "format": "$,.2f"
      }
    ]
  },
"background": "#F7F6F2",
"config": {
  "font": "Inter",
  "title": {
    "font": "Inter",
    "fontSize": 24,
    "fontWeight": 600,
    "color": "#19324D",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#526477",
    "subtitlePadding": 8
  },
  "text": {
    "font": "Inter",
    "fontSize": 16,
    "fill": "#526477"
  },
  "axis": {
    "labelFont": "Inter",
    "labelFontSize": 12,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 12,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "gridColor": "#E2E5E5",
    "gridWidth": 0.7,
    "domain": false,
    "tickColor": "#CBD3D6",
    "labelPadding": 6,
    "titlePadding": 10
  },
  "legend": {
    "labelFont": "Inter",
    "labelFontSize": 12,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 12,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "symbolSize": 100,
    "padding": 8
  },
  "view": {
    "stroke": null
  },
  "bar": {
    "cornerRadiusEnd": 3
  },
  "line": {
    "strokeWidth": 2.5,
    "point": true
  },
  "point": {
    "filled": true,
    "size": 55
  }
}
}

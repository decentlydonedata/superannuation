
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Superannuation Benefits Are Distributed",
    "subtitle": ["Composition of benefit payments across retirement, age 65, preservation age and other categories",
    "Source: Australian Prudential Regulation Authority (2026)"]
  },
  "width": 560,
  "height": 500,
  "data": {
    "url": "data/clean/benefit_payments.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.retirement)",
      "as": "Retirement"
    },
    {
      "calculate": "toNumber(datum.age_65)",
      "as": "Age65"
    },
    {
      "calculate": "toNumber(datum.preservation)",
      "as": "Preservation"
    },
    {
      "calculate": "toNumber(datum.other)",
      "as": "Other"
    },
    {
      "calculate": "datum.Retirement + datum.Age65 + datum.Preservation",
      "as": "ReasonSum"
    },
    {
      "filter": "isValid(datum.ReasonSum) && datum.ReasonSum > 0"
    },
    {
      "calculate": "(datum.Age65 + 0.5 * datum.Preservation) / datum.ReasonSum",
      "as": "x"
    },
    {
      "calculate": "0.8660254 * datum.Preservation / datum.ReasonSum",
      "as": "y"
    },
    {
      "calculate": "indexof(['HESTA', 'Military Superannuation & Benefits Fund No 1', 'CSS Fund'], datum.fund) >= 0 ? 'Highlighted funds' : 'Other funds'",
      "as": "Highlight"
    },
    {
      "calculate": "toNumber(datum.average_payments)",
      "as": "AveragePayments"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {"x": 0, "y": 0, "order": 1},
          {"x": 1, "y": 0, "order": 2},
          {"x": 0.5, "y": 0.8660254, "order": 3},
          {"x": 0, "y": 0, "order": 4}
        ]
      },
      "mark": {
        "type": "line",
        "color": "#19324D",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [-0.16, 1.16],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [-0.12, 1.02],
            "nice": false
          },
          "axis": null
        },
        "order": {
          "field": "order",
          "type": "ordinal"
        }
      }
    },
    {
      "data": {
        "values": [
          {"x": 0, "y": 0},
          {"x": 1, "y": 0},
          {"x": 0.5, "y": 0.8660254}
        ]
      },
      "mark": {
        "type": "circle",
        "color": "#19324D",
        "size": 50,
        "filled": true
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [-0.16, 1.16], "nice": false},
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {"domain": [-0.12, 1.02], "nice": false},
          "axis": null
        }
      }
    },
    {
      "data": {
        "values": [
          {"x": 0, "y": -0.055, "label": "Retirement"},
          {"x": 1, "y": -0.055, "label": "Attaining age 65"},
          {"x": 0.5, "y": 0.925, "label": "Attaining preservation age"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [-0.16, 1.16],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [-0.12, 1.02],
            "nice": false
          },
          "axis": null
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
      "type": "circle",
      "opacity": 0.75,
      "filled": true
    },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [-0.16, 1.16],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [-0.12, 1.02],
            "nice": false
          },
          "axis": null
        },
        "size": {
        "field": "AveragePayments",
        "type": "quantitative",
        "scale": {
          "type": "linear",
          "range": [0, 1500]
        },
        "legend": {
          "title": "Average payments",
          "orient": "bottom",
          "format": ",.0f"
        }
      },
        "color": {
        "field": "Highlight",
        "type": "nominal",
        "scale": {
          "domain": ["Highlighted funds", "Other funds"],
          "range": ["#C49A45", "#247C83"]
        },
        "legend": {
          "title": "Fund group",
          "orient": "bottom"
        }
      },
        "tooltip": [
          {
            "field": "fund",
            "type": "nominal",
            "title": "Fund"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Total benefits paid  ($'000)",
            "format": ",.0f"
          },
          {
            "field": "AveragePayments",
            "type": "quantitative",
            "title": "Average payments",
            "format": ",.2f"
          },
          {
            "field": "Retirement",
            "type": "quantitative",
            "title": "Retirement",
            "format": ".2%"
          },
          {
            "field": "Age65",
            "type": "quantitative",
            "title": "Attaining age 65",
            "format": ".2%"
          },
          {
            "field": "Preservation",
            "type": "quantitative",
            "title": "Attaining preservation age",
            "format": ".2%"
          },
          {
            "field": "Other",
            "type": "quantitative",
            "title": "Other",
            "format": ".2%"
          }
        ]
      }
    }
  ],
  "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}


{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Superannuation Fund Rankings, 2015–2025",
    "subtitle": "Click a fund to highlight its ranking over time"
  },
  "width": 1000,
  "height": 300,
  "data": {
    "url": "data/clean/fund_rankings.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.Year >= 2015 && datum.Year <= 2025"
    },
    {
      "filter": "datum.Ranking_type === 'Assets'"
    }
  ],
  "params": [
    {
      "name": "fundSelect",
      "select": {
        "type": "point",
        "fields": ["Fund"],
        "on": "click",
        "clear": "dblclick"
      }
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 55
    },
    "strokeWidth": 4
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "sort": "ascending",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": {
        "reverse": true,
        "zero": false
      },
      "axis": {
        "tickMinStep": 1
      }
    },
    "detail": {
      "field": "Fund"
    },
    "color": {
  "condition": {
    "param": "fundSelect",
    "field": "Fund",
    "type": "nominal",
    "scale": {
    "domain": [
      "AMP Superannuation Savings Trust",
      "Australian Retirement Trust",
      "AustralianSuper",
      "Aware Super",
      "Colonial First State FirstChoice Superannuation Trust",
      "MLC Super Fund",
      "Public Sector Superannuation Scheme",
      "Retirement Wrap",
      "Unisuper"
    ],
    "range": [
      "#6B9A96",
      "#247C83",
      "#C49A45",
      "#54718C",
      "#85865B",
      "#718B7A",
      "#7896AD",
      "#9A8875",
      "#42666A"
    ]
  }
  },
  "value": "#D3D3D3"
},
    "opacity": {
      "condition": {
        "param": "fundSelect",
        "value": 1
      },
      "value": 0.2
    },
    "strokeWidth": {
      "condition": {
        "param": "fundSelect",
        "value": 4
      },
      "value": 1.5
    },
    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Rank",
        "type": "quantitative",
        "title": "Rank"
      },
      {
        "field": "Fund",
        "type": "nominal",
        "title": "Fund"
      },
      {
        "field": "ABN",
        "type": "nominal",
        "title": "ABN"
      },
      {
        "field": "Members",
        "type": "quantitative",
        "title": "Members",
        "format": ","
      },
      {
        "field": "Members",
        "type": "quantitative",
        "title": "Members",
        "format": ","
      }
    ]
  },
    "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}


{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Superannuation by Age and Gender",
    "subtitle": "Select a measure to compare female and male members"
  },
  "width": 650,
  "height": 500,
  "data": {
    "url": "/data/clean/gender.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "measureSelect",
      "value": "Member accounts ('000)",
      "bind": {
        "input": "select",
        "options": [
          "Member accounts ('000)",
          "Member benefits ($ million)",
          "Average balance ($)"
        ],
        "name": "Measure: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.measure === measureSelect"
    },
    {
      "calculate": "datum.Gender === 'Female' ? -datum.value : datum.value",
      "as": "signedValue"
    }
  ],
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "y": {
      "field": "Age bracket",
      "type": "ordinal",
      "sort": [
        "<25",
        "25 to 29",
        "30 to 34",
        "35 to 39",
        "40 to 44",
        "45 to 49",
        "50 to 54",
        "55 to 59",
        "60 to 64",
        "65 to 69",
        "70 to 74",
        "75 to 84",
        "85+"
      ],
      "title": "Age bracket",
      "axis": {
        "labelLimit": 100
      }
    },
    "x": {
      "field": "signedValue",
      "type": "quantitative",
      "title": "Value",
      "axis": {
        "labelExpr": "format(abs(datum.value), ',.0f')"
      }
    },
    "color": {
      "field": "Gender",
      "type": "nominal",
      "scale": {
        "domain": ["Female", "Male"],
        "range": ["#D95F9F", "#3979C3"]
      },
      "legend": {
        "orient": "top",
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "Age bracket",
        "type": "ordinal",
        "title": "Age bracket"
      },
      {
        "field": "Gender",
        "type": "nominal",
        "title": "Gender"
      },
      {
        "field": "measure",
        "type": "nominal",
        "title": "Measure"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Value",
        "format": ",.2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true
    }
  }
}

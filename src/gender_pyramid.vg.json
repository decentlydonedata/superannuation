
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Superannuation by Age and Gender",
    "subtitle": "Select a measure to compare female and male members"
  },
  "width": 650,
  "height": 500,
  "data": {
    "url": "data/clean/gender.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "measureSelect",
      "value": "Member accounts ('000)",
      "bind": {
        "input": "select",
        "options": [
          "Member accounts ('000)",
          "Member benefits ($ million)",
          "Average balance ($)"
        ],
        "name": "Measure: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.measure === measureSelect"
    },
    {
      "calculate": "datum.Gender === 'Female' ? -datum.value : datum.value",
      "as": "signedValue"
    }
  ],
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "y": {
      "field": "Age bracket",
      "type": "ordinal",
      "sort": [
        "<25",
        "25 to 29",
        "30 to 34",
        "35 to 39",
        "40 to 44",
        "45 to 49",
        "50 to 54",
        "55 to 59",
        "60 to 64",
        "65 to 69",
        "70 to 74",
        "75 to 84",
        "85+"
      ],
      "title": "Age bracket",
      "axis": {
        "labelLimit": 100
      }
    },
    "x": {
      "field": "signedValue",
      "type": "quantitative",
      "title": "Value",
      "axis": {
        "labelExpr": "format(abs(datum.value), ',.0f')"
      }
    },
    "color": {
      "field": "Gender",
      "type": "nominal",
      "scale": {
        "domain": ["Female", "Male"],
        "range": ["#C49A45", "#247C83"]
      },
      "legend": {
        "orient": "top",
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "Age bracket",
        "type": "ordinal",
        "title": "Age bracket"
      },
      {
        "field": "Gender",
        "type": "nominal",
        "title": "Gender"
      },
      {
        "field": "measure",
        "type": "nominal",
        "title": "Measure"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Value",
        "format": ",.2f"
      }
    ]
  },
    "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}

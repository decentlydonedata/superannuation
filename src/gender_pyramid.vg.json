
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Superannuation by Age and Gender",
    "subtitle": "Comparing member accounts, member benefits and average balances"
  },
  "data": {
    "url": "data/clean/gender.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.Gender === 'Female' ? -datum.value : datum.value",
      "as": "signedValue"
    }
  ],
  "facet": {
    "field": "measure",
    "type": "nominal",
    "sort": [
      "Member accounts ('000)",
      "Member benefits ($ million)",
      "Average balance ($)"
    ],
    "columns": 3,
    "header": {
      "title": null,
      "labelFont": "Inter",
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#19324D",
      "labelLimit": 180,
      "labelPadding": 12
    }
  },
  "spec": {
    "width": 300,
    "height": 400,
    "mark": {
      "type": "bar",
      "cornerRadiusEnd": 3
    },
    "encoding": {
      "y": {
        "field": "Age bracket",
        "type": "ordinal",
        "sort": [
          "<25",
          "25 to 29",
          "30 to 34",
          "35 to 39",
          "40 to 44",
          "45 to 49",
          "50 to 54",
          "55 to 59",
          "60 to 64",
          "65 to 69",
          "70 to 74",
          "75 to 84",
          "85+"
        ],
        "title": "Age bracket",
        "axis": {
          "labelLimit": 100,
          "labelFont": "Inter",
          "labelFontSize": 11,
          "titleFont": "Inter",
          "titleFontSize": 13
        }
      },
      "x": {
        "field": "signedValue",
        "type": "quantitative",
        "title": null,
        "axis": {
          "labelExpr": "format(abs(datum.value), ',.0f')",
          "labelFont": "Inter",
          "labelFontSize": 10,
          "tickCount": 4,
          "grid": true,
          "gridColor": "#E2E5E5",
          "domain": false
        }
      },
      "color": {
        "field": "Gender",
        "type": "nominal",
        "scale": {
          "domain": ["Female", "Male"],
          "range": ["#C49A45", "#247C83"]
        },
        "legend": {
          "orient": "top",
          "title": null,
          "labelFont": "Inter",
          "labelFontSize": 13,
          "symbolSize": 100
        }
      },
      "tooltip": [
        {
          "field": "Age bracket",
          "type": "ordinal",
          "title": "Age bracket"
        },
        {
          "field": "Gender",
          "type": "nominal",
          "title": "Gender"
        },
        {
          "field": "measure",
          "type": "nominal",
          "title": "Measure"
        },
        {
          "field": "value",
          "type": "quantitative",
          "title": "Value",
          "format": ",.2f"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "y": "shared",
      "x": "independent",
      "color": "shared"
    },
    "axis": {
      "y": "shared"
    }
  },
  "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Playfair Display",
      "fontSize": 24,
      "fontWeight": 700,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12,
      "subtitleFont": "Inter",
      "subtitleFontSize": 16,
      "subtitleFontWeight": 400,
      "subtitleColor": "#526477",
      "subtitlePadding": 8
    },
    "text": {
      "font": "Inter",
      "fontSize": 16,
      "fill": "#526477"
    },
    "axis": {
      "labelColor": "#526477",
      "titleColor": "#19324D",
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelColor": "#526477",
      "titleColor": "#19324D",
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    }
  }
}

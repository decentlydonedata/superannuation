
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Retirees Are Distributed Across Australia",
    "subtitle": ["Each dot represents approximately 100 retirees, mapped by Statistical Area Level 1 (SA1)", 
                " Source: Australian Bureau of Statistics (Census 2021)"]
  },
  "width": 700,
  "height": 600,
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 700,
    "translate": [380, 300]
  },
  "layer": [
    {
      "data": {
        "url": "data/boundaries/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#FFFFFF",
        "stroke": "#E2E5E5",
        "strokeWidth": 0.8
      }
    },

{
  "data": {
    "url": "data/clean/retiree_dots.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.longitude) && isValid(datum.latitude)"
    },
    {
      "filter": "datum.age_group === '50% or less'"
    }
  ],
  "mark": {
    "type": "circle",
    "filled": true,
    "size": 10,
    "opacity": 0.2,
    "color": "#247C83",
    "stroke": "#F7F6F2",
    "strokeWidth": 0.2
  },
  "encoding": {
    "longitude": {
      "field": "longitude",
      "type": "quantitative"
    },
    "latitude": {
      "field": "latitude",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "SA1",
        "type": "nominal",
        "title": "SA1"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Retiree percentage",
        "format": ".0%"
      },
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Retiree share group"
      }
    ]
  }
},
{
  "data": {
    "url": "data/clean/retiree_dots.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.longitude) && isValid(datum.latitude)"
    },
    {
      "filter": "datum.age_group !== '50% or less'"
    }
  ],
  "mark": {
    "type": "circle",
    "filled": true,
    "size": 10,
    "opacity": 1,
    "color": "#C49A45",
    "stroke": "#F7F6F2",
    "strokeWidth": 0.2
  },
  "encoding": {
    "longitude": {
      "field": "longitude",
      "type": "quantitative"
    },
    "latitude": {
      "field": "latitude",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "SA1",
        "type": "nominal",
        "title": "SA1"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Retiree percentage",
        "format": ".0%"
      },
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Retiree share group"
      }
    ]
  }
},

{
  "data": {
    "values": [
      {
        "age_group": "50% or less",
        "x": 0,
        "y": 0
      },
      {
        "age_group": "Over 50%",
        "x": 1,
        "y": 0
      }
    ]
  },
  "mark": {
    "type": "point",
    "opacity": 0
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [0, 1]
      }
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "axis": null
    },
    "color": {
      "field": "age_group",
      "type": "nominal",
      "title": "Retiree share",
      "scale": {
        "domain": [
          "50% or less",
          "Over 50%"
        ],
        "range": [
          "#247C83",
          "#C49A45"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "symbolType": "circle"
      }
    }
  }
}
  ],
  "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}


{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot map showing the distribution of retirees across Australian SA1 areas. Each dot represents 100 retirees.",
  "width": 700,
  "height": 650,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/boundaries/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f2f2f2",
        "stroke": "#999999",
        "strokeWidth": 0.5
      }
    },
    {
    "data": {
      "url": "data/clean/retiree_dots.csv",
      "format": {"type": "csv"}
    },
    "mark": {
      "type": "circle",
      "opacity": 0.55,
      "size": 5
    },
    "encoding": {
      "longitude": {
        "field": "longitude",
        "type": "quantitative"
      },
      "latitude": {
        "field": "latitude",
        "type": "quantitative"
      },
      "color": {
        "field": "age_group",
        "type": "nominal",
        "scale": {
          "domain": ["Over 70%", "70% or less", "Unknown"],
          "range": ["#C49A45", "#247C83", "#B8B8B8"]
        },
        "legend": {
          "title": "SA1 population aged over 60"
        }
      },
      "tooltip": [
        {
          "field": "longitude",
          "type": "quantitative",
          "format": ".3f",
          "title": "Longitude"
        },
        {
          "field": "latitude",
          "type": "quantitative",
          "format": ".3f",
          "title": "Latitude"
        },
        {
          "field": "Percentage",
          "type": "quantitative",
          "title": "Population aged over 60 (%)"
        }
      ]
    }
  }
  ],
      "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}

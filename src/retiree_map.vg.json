
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot map showing the distribution of retirees across Australian SA1 areas. Each dot represents 100 retirees.",
  "width": 700,
  "height": 650,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/boundaries/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f2f2f2",
        "stroke": "#999999",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/clean/retiree_dots.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "circle",
        "color": "#2878B5",
        "opacity": 0.55,
        "size": 5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "longitude",
            "type": "quantitative",
            "format": ".3f",
            "title": "Longitude"
          },
          {
            "field": "latitude",
            "type": "quantitative",
            "format": ".3f",
            "title": "Latitude"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Superannuation Account Balance by State and Gender",
    "subtitle": ["Pie size represents average account balance; slices represent gender proportions",
                "Source: Australian Taxation Office (2024)"]
  },
  "width": 760,
  "height": 600,
  "params": [
  {
    "name": "incomeYear",
    "value": 2014,
    "bind": {
      "input": "range",
      "min": 2014,
      "max": 2023,
      "step": 1,
      "name": "Income year: "
    }
  }
],
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 700,
    "translate": [380, 300]
  },
  "layer": [
    {
        "data": {
        "url": "data/boundaries/states.geojson",
        "format": {
            "type": "json"
        }
        },
      "mark": {
        "type": "geoshape",
        "fill": "#FFFFFF",
        "stroke": "#E2E5E5",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/clean/state_balances_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum['Income year']) == incomeYear"
        },
        {
          "calculate": "toNumber(datum['Average account balance'])",
          "as": "Balance"
        },
        {
          "calculate": "toNumber(datum['Proportion'])",
          "as": "Gender proportion"
        },
        {
          "calculate": "toNumber(datum['Longitude'])",
          "as": "Lon"
        },
        {
          "calculate": "toNumber(datum['Latitude'])",
          "as": "Lat"
        }
      ],
      "mark": {
        "type": "arc",
        "stroke": "white",
        "strokeWidth": 0.8,
        "outerRadius": 35
      },
      "encoding": {
        "longitude": {
          "field": "Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Lat",
          "type": "quantitative"
        },
        "theta": {
          "field": "Gender proportion",
          "type": "quantitative",
          "stack": true
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#247C83", "#C49A45"]
          },
          "legend": {
            "title": "Gender",
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle",
            "labelFont": "Inter",
            "labelFontSize": 12,
            "titleFont": "Inter",
            "titleFontSize": 12,
            "titleColor": "#19324D",
            "labelColor": "#526477",
            "symbolSize": 120,
            "padding": 10
          }
        },
          "radius": {
            "field": "Balance",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "domain": [80000, 200000],
              "range": [12, 35],
              "zero": false,
              "clamp": true
            }
          },
        "tooltip": [
          {
            "field": "State/Territory",
            "type": "nominal",
            "title": "State/Territory"
          },
          {
            "field": "Income year",
            "type": "ordinal",
            "title": "Income year"
          },
          {
            "field": "Gender",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "Balance",
            "type": "quantitative",
            "title": "Average account balance ($)",
            "format": ",.0f"
          },
          {
            "field": "Gender proportion",
            "type": "quantitative",
            "title": "Gender proportion",
            "format": ".1%"
          }
        ]
      }
    }
  ],
      "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "titleColor": "#19324D",
      "labelColor": "#526477",
      "symbolSize": 100,
      "padding": 8,
      "titleLineHeight": 14
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "From Policy to Paycheque: The Evolution of Super",
    "subtitle": ["Timeline of superannuation Guarentee contribution rates and key legislative milestones, 1992–2026",
                "Source: Australian Tax Office; Parliament of Australia; Australian Treasury"]
  },
  "description": "Vertical timeline of Australian superannuation guarantee rates and legislative changes.",
  "data": {
    "url": "data/raw/Legislature.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Year)",
      "as": "YearNum"
    },
    {
      "calculate": "toNumber(datum.Rate)",
      "as": "RateNum"
    },
    {
      "filter": "datum.YearNum >= 1992 && datum.YearNum <= 2026"
    },
    {
      "calculate": "datum.Act != null && datum.Act != '' ? 'Legislative milestone' : (datum.Legislature == 'SG rate increase' ? 'SG rate increase' : 'No legislative change')",
      "as": "EventType"
    },
    {
      "calculate": "datum.Description != null && trim(datum.Description) != '' ? datum.Description : null",
      "as": "EventDescription"
    },
    {
    "calculate": "datum.Legislature != 'No legislative change' ? datum.Act : null",
    "as": "ActTooltip"
    },
    {
    "calculate": "toNumber(datum.Year)",
    "as": "YearNum"
    }
  ],
  "hconcat": [
    {
      "width": 180,
      "height": 560,
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#D9E5E5",
            "strokeWidth": 2
          },
          "encoding": {
            "x": {
              "field": "RateNum",
              "type": "quantitative",
              "scale": {
                "domain": [0, 12.5],
                "nice": false
              },
              "axis": {
                "title": "SG rate (%)",
                "orient": "bottom",
                "tickCount": 4,
                "grid": true,
                "gridColor": "#E2E5E5"
              }
            },
            "y": {
                "field": "YearNum",
                "type": "quantitative",
                "scale": {
                  "domain": [1992, 2026],
                  "reverse": true,
                  "nice": false
                },
                "axis": {
                  "title": null,
                  "orient": "right",
                  "values": [1992,1993,1994,1995,1996,1997,1998,1999,
                    2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,
                    2010,2011,2012,2023,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026],
                  "format": "d",
                  "grid": true,
                  "labels": true,
                  "ticks": true,
                  "domain": true
                }
              },
            "order": {
              "field": "YearNum",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 90,
            "stroke": "#F7F6F2",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "RateNum",
              "type": "quantitative",
              "scale": {
                "domain": [0, 12.5],
                "nice": false
              }
            },
            "y": {
              "field": "YearNum",
              "type": "quantitative",
              "scale": {
                "domain": [1992, 2026],
                "reverse": true,
                "nice": false
              }
            },
            "color": {
              "field": "EventType",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Legislative milestone",
                  "SG rate increase",
                  "No legislative change"
                ],
                "range": [
                  "#247C83",
                  "#C49A45",
                  "#E2E5E5"
                ]
              },
              "legend": {
                "title": "Event type",
                "orient": "top"
              }
            },
            "tooltip": [
              {
                "field": "YearNum",
                "type": "quantitative",
                "title": "Year",
                "format": "d"
              },
              {
                "field": "RateNum",
                "type": "quantitative",
                "title": "SG rate",
                "format": ".1f"
              },
              {
                "field": "ActTooltip",
                "type": "nominal",
                "title": "Act"
              }
            ]
          }
        }
      ]
    },
    {
      "width": 820,
      "height": 560,
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 12,
        "color": "#19324D",
        "limit": 780
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "field": "YearNum",
          "type": "quantitative",
          "scale": {
            "domain": [1992, 2026],
            "reverse": true,
            "nice": false
          },
          "axis": null
        },
        "opacity": {
          "condition": {
            "test": "isValid(datum.EventDescription)",
            "value": 1
          },
          "value": 0
        },
        "text": {
          "field": "EventDescription",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "YearNum",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Act",
            "type": "nominal",
            "title": "Act"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "shared"
    }
  },
"background": "#F7F6F2",
"config": {
  "font": "Inter",
  "title": {
    "font": "Inter",
    "fontSize": 24,
    "fontWeight": 600,
    "color": "#19324D",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#526477",
    "subtitlePadding": 8
  },
  "text": {
    "font": "Inter",
    "fontSize": 16,
    "fill": "#526477"
  },
  "axis": {
    "labelFont": "Inter",
    "labelFontSize": 12,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 12,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "gridColor": "#E2E5E5",
    "gridWidth": 0.7,
    "domain": false,
    "tickColor": "#CBD3D6",
    "labelPadding": 6,
    "titlePadding": 10
  },
  "legend": {
    "labelFont": "Inter",
    "labelFontSize": 12,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 12,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "symbolSize": 100,
    "padding": 8
  },
  "view": {
    "stroke": null
  },
  "bar": {
    "cornerRadiusEnd": 3
  },
  "line": {
    "strokeWidth": 2.5,
    "point": true
  },
  "point": {
    "filled": true,
    "size": 55
  }
}
}

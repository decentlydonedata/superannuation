
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/raw/Legislature.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Year)",
      "as": "Year_numeric"
    },
    {
      "calculate": "toNumber(datum.Rate)",
      "as": "Rate_numeric"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": false,
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Year_numeric",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d"
          }
        },
        "y": {
          "field": "Rate_numeric",
          "type": "quantitative",
          "title": "Rate"
        },
        "order": {
          "field": "Year_numeric",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Rate_numeric",
            "type": "quantitative",
            "title": "Rate"
          }
        ]
      }
    },
    {
      "transform": [
            {
            "filter": "datum.Legislature != null && datum.Legislature != '' && datum.Legislature != 'SG rate increase'"
            }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "color": "#247C83"
      },
      "encoding": {
        "x": {
          "field": "Year_numeric",
          "type": "quantitative",
          "title": "Year"
        },
        "y": {
          "field": "Rate_numeric",
          "type": "quantitative",
          "title": "Rate"
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Rate_numeric",
            "type": "quantitative",
            "title": "Rate"
          },
          {
            "field": "Legislature",
            "type": "nominal",
            "title": "Legislature"
          },
          {
            "field": "Act",
            "type": "nominal",
            "title": "Act"
          },
          {
            "field": "Description",
            "type": "nominal",
            "title": "Description"
          }
        ]
      }
    }
  ],
      "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}

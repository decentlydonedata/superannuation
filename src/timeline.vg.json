
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "/data/raw/Legislature.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Year)",
      "as": "Year_numeric"
    },
    {
      "calculate": "toNumber(datum.Rate)",
      "as": "Rate_numeric"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": false,
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Year_numeric",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d"
          }
        },
        "y": {
          "field": "Rate_numeric",
          "type": "quantitative",
          "title": "Rate"
        },
        "order": {
          "field": "Year_numeric",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Rate_numeric",
            "type": "quantitative",
            "title": "Rate"
          }
        ]
      }
    },
    {
      "transform": [
            {
            "filter": "datum.Legislature != null && datum.Legislature != '' && datum.Legislature != 'SG rate increase'"
            }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "color": "#D62728"
      },
      "encoding": {
        "x": {
          "field": "Year_numeric",
          "type": "quantitative",
          "title": "Year"
        },
        "y": {
          "field": "Rate_numeric",
          "type": "quantitative",
          "title": "Rate"
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Rate_numeric",
            "type": "quantitative",
            "title": "Rate"
          },
          {
            "field": "Legislature",
            "type": "nominal",
            "title": "Legislature"
          },
          {
            "field": "Act",
            "type": "nominal",
            "title": "Act"
          },
          {
            "field": "Description",
            "type": "nominal",
            "title": "Description"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "title": {
        "font": "Inter",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#172B4D",
        "anchor": "start"
    },
    "axis": {
        "labelFont": "Inter",
        "titleFont": "Inter",
        "labelColor": "#344054",
        "titleColor": "#344054",
        "gridColor": "#E8EEF2",
        "domainColor": "#CBD5E1"
    },
    "legend": {
        "labelFont": "Inter",
        "titleFont": "Inter",
        "labelColor": "#344054",
        "titleColor": "#172B4D"
    },
    "view": {
        "stroke": null
    }
  }
}


{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Word cloud showing superannuation-related word frequencies",
  "width": 800,
  "height": 450,
  "padding": 12,
  "autosize": "none",
  "data": [
    {
      "name": "table",
      "url": "data/clean/word_cloud.csv",
      "format": {
        "type": "csv",
        "parse": {
          "n": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.name != null && trim(datum.name) !== '' && isValid(datum.n) && datum.n > 0"
        },
        {
          "type": "collect",
          "sort": {
            "field": "n",
            "order": "descending"
          }
        },
        {
          "type": "formula",
          "as": "angle",
          "expr": "[-45, 0, 0, 0, 0, 45][floor(random() * 6)]"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "wordColor",
      "type": "ordinal",
      "domain": {
        "data": "table",
        "field": "name"
      },
      "range": [
        "#19324D",
        "#247C83",
        "#C49A45",
        "#54718C",
        "#718B7A"
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "from": {
        "data": "table"
      },
      "transform": [
        {
          "type": "wordcloud",
          "size": [
            800,
            450
          ],
          "text": {
            "field": "name"
          },
          "font": "Inter",
          "fontWeight": "bold",
          "fontSize": {
            "field": "n"
          },
          "fontSizeRange": [
            13,
            60
          ],
          "rotate": {
            "field": "angle"
          },
          "padding": 3,
          "spiral": "archimedean"
        }
      ],
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "alphabetic"
          },
          "fill": {
            "scale": "wordColor",
            "field": "name"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "font": {
            "field": "font"
          },
          "fontSize": {
            "field": "fontSize"
          },
          "fontWeight": {
            "field": "fontWeight"
          },
          "angle": {
            "field": "angle"
          },
          "fillOpacity": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Word': datum.name, 'Frequency': datum.n}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.65
          }
        }
      }
    }
  ],
  "background": "#F7F6F2",
  "config": {
    "font": "Inter",
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#19324D",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#19324D",
      "gridColor": "#E2E5E5",
      "gridWidth": 0.7,
      "domain": false,
      "tickColor": "#CBD3D6",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Inter",
      "labelFontSize": 11,
      "labelColor": "#526477",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleColor": "#19324D",
      "symbolSize": 100,
      "padding": 8
    },
    "view": {
      "stroke": null
    },
    "bar": {
      "cornerRadiusEnd": 3
    },
    "line": {
      "strokeWidth": 2.5,
      "point": true
    },
    "point": {
      "filled": true,
      "size": 55
    }
  }
}

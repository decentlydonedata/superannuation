{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Gender and Geographic Inequality",
    "subtitle": ["Pie size represents average account balance; slices represent gender proportions",
                "Source: Australian Taxation Office (2024)"]
  },
  "width": 420,
  "height": 420,
  "params": [
  {
    "name": "incomeYear",
    "value": 2014,
    "bind": {
      "input": "range",
      "min": 2014,
      "max": 2023,
      "step": 1,
      "name": "Income year: "
    }
  }
],
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 500,
    "translate": [200, 200]
  },
  "layer": [
    {
        "data": {
        "url": "data/boundaries/states.geojson",
        "format": {
            "type": "json"
        }
        },
      "mark": {
        "type": "geoshape",
        "fill": "#FFFFFF",
        "stroke": "#718B7A",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/clean/state_balances_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum['Income year']) == incomeYear"
        },
        {
          "calculate": "toNumber(datum['Average account balance'])",
          "as": "Balance"
        },
        {
          "calculate": "toNumber(datum['Proportion'])",
          "as": "Gender proportion"
        },
        {
          "calculate": "toNumber(datum['Longitude'])",
          "as": "Lon"
        },
        {
          "calculate": "toNumber(datum['Latitude'])",
          "as": "Lat"
        }
      ],
      "mark": {
        "type": "arc",
        "stroke": "white",
        "strokeWidth": 0.8,
        "outerRadius": 0
      },
      "encoding": {
        "longitude": {
          "field": "Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Lat",
          "type": "quantitative"
        },
        "theta": {
          "field": "Gender proportion",
          "type": "quantitative",
          "stack": true
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#247C83", "#C49A45"]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "circle",
            "labelFont": "Inter",
            "labelFontSize": 12,
            "titleFont": "Inter",
            "titleFontSize": 12,
            "titleColor": "#19324D",
            "labelColor": "#526477",
            "symbolSize": 120,
            "padding": 10
          }
        },
          "radius": {
            "field": "Balance",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "domain": [80000, 200000],
              "range": [12, 28],
              "clamp": true,
              "zero": false
            }
          },
        "tooltip": [
          {
            "field": "State/Territory",
            "type": "nominal",
            "title": "State/Territory"
          },
          {
            "field": "Income year",
            "type": "ordinal",
            "title": "Income year"
          },
          {
            "field": "Gender",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "Balance",
            "type": "quantitative",
            "title": "Average account balance ($)",
            "format": ",.0f"
          },
          {
            "field": "Gender proportion",
            "type": "quantitative",
            "title": "Gender proportion",
            "format": ".1%"
          }
        ]
      }
    },
    {
    "data": {
      "values": [
        {
          "lon": 149,
          "lat": -35,
          "lon2": 149,
          "lat2": -7
        }
      ]
    },
    "mark": {
      "type": "rule",
      "color": "#19324D",
      "strokeWidth": 1
    },
    "encoding": {
      "longitude": {
        "field": "lon",
        "type": "quantitative"
      },
      "latitude": {
        "field": "lat",
        "type": "quantitative"
      },
      "longitude2": {
        "field": "lon2"
      },
      "latitude2": {
        "field": "lat2"
      }
    }
  },
  {
    "data": {
      "values": [
        {
          "lon": 113,
          "lat": -43,
          "label": "State-level balances are becoming more similar"
        },
        {
          "lon": 113,
          "lat": -7,
          "label": "Gender wealth shares are converging, with the ACT most equitable"
        }
      ]
    },
    "mark": {
      "type": "text",
      "font": "Inter",
      "fontSize": 12,
      "fontWeight": 500,
      "color": "#19324D",
      "align": "left",
      "baseline": "bottom",
      "dx": 5,
      "dy": -4
    },
    "encoding": {
      "longitude": {
        "field": "lon",
        "type": "quantitative"
      },
      "latitude": {
        "field": "lat",
        "type": "quantitative"
      },
      "text": {
        "field": "label"
      }
    }
  }
  ],
"background": "#F7F6F2",
"config": {
  "font": "Inter",
  "title": {
    "font": "Inter",
    "fontSize": 24,
    "fontWeight": 600,
    "color": "#19324D",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleFontWeight": 400,
    "subtitleColor": "#526477",
    "subtitlePadding": 8
  },
  "text": {
    "font": "Inter",
    "fontSize": 16,
    "fill": "#526477"
  },
  "axis": {
    "labelFont": "Inter",
    "labelFontSize": 16,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 16,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "gridColor": "#E2E5E5",
    "gridWidth": 0.7,
    "domain": false,
    "tickColor": "#CBD3D6",
    "labelPadding": 6,
    "titlePadding": 10
  },
  "legend": {
    "labelFont": "Inter",
    "labelFontSize": 16,
    "labelColor": "#526477",
    "titleFont": "Inter",
    "titleFontSize": 16,
    "titleFontWeight": 500,
    "titleColor": "#19324D",
    "symbolSize": 100,
    "padding": 8
  },
  "view": {
    "stroke": null
  },
  "bar": {
    "cornerRadiusEnd": 3
  },
  "line": {
    "strokeWidth": 2.5,
    "point": true
  },
  "point": {
    "filled": true,
    "size": 55
  }
}
}